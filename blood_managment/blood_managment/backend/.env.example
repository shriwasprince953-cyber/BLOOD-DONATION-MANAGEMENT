APP_NAME="Blood Donation Management API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Comma-separated frontend origins.
# Example: http://localhost:3000,http://localhost:5173,https://your-frontend.com
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Supabase Postgres connection string.
# Use the pooled connection URL in production.
DATABASE_URL=

# Supabase Auth project settings.
SUPABASE_URL="
SUPABASE_ANON_KEY="
SUPABASE_SERVICE_ROLE_KEY="""

# Local development only. In production use migrations instead.
AUTO_CREATE_TABLES=false

# Notification provider placeholders.
# Current implementation queues in-app notification rows. Add provider integration later.
NOTIFICATION_DRY_RUN=true
SMS_PROVIDER=""
SMS_API_KEY=""
EMAIL_FROM=""
